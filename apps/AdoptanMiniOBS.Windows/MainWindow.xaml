<Window x:Class="AdoptanMiniOBS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adoptan Mini OBS"
        Width="1320"
        Height="850"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="a"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                        </Border>
                        <StackPanel Margin="11,2,0,0">
                            <TextBlock Text="Adoptan Mini OBS" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Windows · caméra iPhone · RTMP"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1 · LIAISON IPHONE" FontSize="12" FontWeight="Bold" Foreground="#BDAAFF"/>
                            <TextBlock Text="Colle la clé privée adoptan.ai, puis scanne le QR avec l’iPhone."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,10"/>
                            <PasswordBox x:Name="IPhoneKeyBox"
                                         PasswordChanged="IPhoneKeyBox_OnPasswordChanged"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="112"
                                        Height="112"
                                        CornerRadius="8"
                                        Background="White"
                                        Padding="5">
                                    <Image x:Name="QrImage" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="CopyPhoneLinkButton"
                                            Content="Copier le lien"
                                            Click="CopyPhoneLinkButton_OnClick"
                                            Margin="0,0,0,7"/>
                                    <Button x:Name="OpenPhoneLinkButton"
                                            Content="Ouvrir le lien"
                                            Click="OpenPhoneLinkButton_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2 · SOURCES" FontSize="12" FontWeight="Bold" Foreground="#BDAAFF"/>
                            <Label Content="Écran à capturer" Margin="0,10,0,0"/>
                            <ComboBox x:Name="DisplayCombo"/>

                            <CheckBox x:Name="ShowCursorCheck" Content="Afficher le curseur" IsChecked="True" Margin="0,10,0,2"/>

                            <Label Content="Micro du PC (optionnel)" Margin="0,8,0,0"/>
                            <ComboBox x:Name="MicrophoneCombo"/>

                            <Label Content="Son Windows / Stereo Mix (optionnel)" Margin="0,10,0,0"/>
                            <ComboBox x:Name="SystemAudioCombo"/>

                            <Button Content="Actualiser les périphériques audio"
                                    Click="RefreshAudioButton_OnClick"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3 · SCÈNE" FontSize="12" FontWeight="Bold" Foreground="#BDAAFF"/>
                            <Label Content="Disposition" Margin="0,10,0,0"/>
                            <ComboBox x:Name="SceneCombo"/>
                            <Label Content="Position de l’incrustation" Margin="0,10,0,0"/>
                            <ComboBox x:Name="PositionCombo"/>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="Taille caméra" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="PipSizeLabel"
                                           Text="28 %"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <Slider x:Name="PipSizeSlider"
                                    Minimum="18"
                                    Maximum="48"
                                    Value="28"
                                    TickFrequency="2"
                                    ValueChanged="PipSizeSlider_OnValueChanged"/>
                            <CheckBox x:Name="MirrorCameraCheck" Content="Effet miroir caméra"/>
                            <CheckBox x:Name="RotateCameraCheck" Content="Retourner la caméra à 180°"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="4 · QUALITÉ" FontSize="12" FontWeight="Bold" Foreground="#BDAAFF"/>
                            <Label Content="Résolution" Margin="0,10,0,0"/>
                            <ComboBox x:Name="ResolutionCombo"
                                      SelectionChanged="ResolutionCombo_OnSelectionChanged"/>
                            <Label Content="Images par seconde" Margin="0,10,0,0"/>
                            <ComboBox x:Name="FrameRateCombo"/>
                            <Label x:Name="VideoBitrateLabel" Content="Vidéo : 3500 kb/s" Margin="0,10,0,0"/>
                            <Slider x:Name="VideoBitrateSlider"
                                    Minimum="1500"
                                    Maximum="8000"
                                    Value="3500"
                                    TickFrequency="250"
                                    ValueChanged="VideoBitrateSlider_OnValueChanged"/>
                            <Label Content="Audio" Margin="0,10,0,0"/>
                            <ComboBox x:Name="AudioBitrateCombo"/>
                            <Button Content="Profil stable 720p30"
                                    Click="StableProfileButton_OnClick"
                                    Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="5 · DIFFUSION" FontSize="12" FontWeight="Bold" Foreground="#BDAAFF"/>
                            <Label Content="Plateforme" Margin="0,10,0,0"/>
                            <ComboBox x:Name="PlatformCombo"
                                      SelectionChanged="PlatformCombo_OnSelectionChanged"/>
                            <Label Content="Serveur RTMPS" Margin="0,10,0,0"/>
                            <TextBox x:Name="ServerUrlBox"/>
                            <Label Content="Clé de stream" Margin="0,10,0,0"/>
                            <PasswordBox x:Name="StreamKeyBox"/>
                            <TextBlock Text="La clé n’est ni enregistrée ni affichée dans les logs."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="APERÇU DU PROGRAMME" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Connecte l’iPhone puis démarre l’aperçu."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border x:Name="StatusPill"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#252234"
                            CornerRadius="14"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#777184" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusLabel" Text="PRÊT" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Border Background="Black"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <StackPanel x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="◉"
                                       HorizontalAlignment="Center"
                                       FontSize="58"
                                       Foreground="#5E5870"/>
                            <TextBlock Text="L’aperçu exact apparaîtra ici"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="Écran Windows + caméra de l’iPhone"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border x:Name="LiveBadge"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource DangerBrush}"
                                CornerRadius="7"
                                Padding="10,6"
                                Margin="14">
                            <TextBlock Text="EN DIRECT" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="QualitySummary"
                               Grid.Column="0"
                               Text="1280 × 720 · 30 i/s · 3500 kb/s"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="PreviewButton"
                            Grid.Column="1"
                            Content="Démarrer l’aperçu"
                            Style="{StaticResource PrimaryButton}"
                            Click="PreviewButton_OnClick"
                            Margin="0,0,10,0"/>
                    <Button x:Name="LiveButton"
                            Grid.Column="2"
                            Content="Lancer le direct"
                            Style="{StaticResource LiveButton}"
                            Click="LiveButton_OnClick"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
